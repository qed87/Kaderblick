{
  "name": "kaderblick-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:features",
    "test:unit": "node --test \"test/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "test:features": "cucumber-js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@kurrent/kurrentdb-client": "^1.3.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "neverthrow": "^8.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-neverthrow": "^1.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
